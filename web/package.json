{
  "name": "autoprintcode-web",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "AutoPrintCode в браузере: страница + локальный помощник печати на Node.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts --dev",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/parity.test.ts tests/engine.test.ts tests/textprint.test.ts",
    "test:ui": "npm run build && node --test tests/ui.test.ts"
  },
  "dependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.16",
    "koffi": "^3.3.2",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
