# --- Рабочие данные пользователя (образцы, настройки, журнал) ---
data/

# Таймер вебинара: шаблоны и настройки едут с папкой и хранятся в git (резервная копия);
# журнал, блокировка, копия .bak и значок — у каждого свои
!webinar_timer/data/
webinar_timer/data/logs/
webinar_timer/data/*.bak
webinar_timer/data/webinar.ico
webinar_timer/webinar.ico
# медиа (видео, фон, шрифт) копируются вместе с папкой, но в git не кладутся — большие файлы
webinar_timer/media/*
!webinar_timer/media/README.md

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.python-version

# --- Сборка (PyInstaller) ---
build/
dist/
*.spec.bak

# --- Подпись кода: сертификаты и ключи НИКОГДА не коммитить ---
*.pfx
*.p12
*.cer
*.key
*.pem
signing/

# --- Тесты ---
tests/_run/
tests/pages/node_modules/
tests/pages/cm6bundle.js
tests/pages/package-lock.json

# --- Медиа для таймера вебинара (большие файлы — у каждого свои) ---
*.mp4
*.mov
Фон.jpg

# --- Дистрибутив таймера для коллег (собирает tools/build_webinar_dist.py; сотни МБ) ---
INSTALL/*.exe
INSTALL/*.json
INSTALL/*/

# --- Временное и служебное ---
*.log
*.tmp
*.lock
.lock
*.7z
*.zip

# --- Редакторы и ОС ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
